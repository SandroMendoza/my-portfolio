{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site only — Workers static assets, no Worker script/API.
  // See docs/architecture/decisions/0003-hosting-cloudflare-workers-static-assets.md
  "name": "my-portfolio",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "development": {
      "name": "my-portfolio-development"
    },
    "production": {
      "name": "my-portfolio-production"
    }
  }
}
